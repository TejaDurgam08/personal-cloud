server {
    listen 80;
    server_name _;

    client_max_body_size 500M;  

    root /../frontend/dist;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;    
        proxy_request_buffering off; 
    }
}
